# The site's real domain once one is connected — used for metadata,
# OpenGraph URLs, sitemap.xml, and robots.txt. Falls back to localhost.
# NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Project Configurator lead emails (app/api/lead/route.ts).
# Without these set, submitted leads are logged server-side instead of
# emailed — the flow still works end-to-end for local development.

# https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives new project inquiries.
LEAD_NOTIFICATION_EMAIL=

# Optional — defaults to Resend's shared onboarding sender.
# LEAD_FROM_EMAIL="Your Studio <hello@yourdomain.com>"

# WhatsApp number for the "WhatsApp Me" buttons — international format,
# digits only (country code + number, e.g. 50212345678). Leave unset and
# the WhatsApp buttons don't render.
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# The contact address shown on the site (footer, "Email me" buttons).
# Defaults to the personal inbox already in use — point this at the
# branded domain address (e.g. hello@javierdigital.com) once that
# mailbox exists and actually receives mail.
# NEXT_PUBLIC_CONTACT_EMAIL=
